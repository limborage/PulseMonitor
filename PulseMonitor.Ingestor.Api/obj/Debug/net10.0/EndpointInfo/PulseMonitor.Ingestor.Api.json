{
  "openapi": "3.1.1",
  "info": {
    "title": "PulseMonitor.Ingestor.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5216"
    }
  ],
  "paths": {
    "/Metrics": {
      "post": {
        "tags": [
          "Metrics"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HeartbeatMetric"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/HeartbeatMetric"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/HeartbeatMetric"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/Metrics/latest": {
      "get": {
        "tags": [
          "Metrics"
        ],
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HeartbeatMetric": {
        "required": [
          "deviceId",
          "cpuUsage",
          "memoryUsage",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "cpuUsage": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "memoryUsage": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "timestamp": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Metrics"
    }
  ]
}